# Salin file ini menjadi .env dan isi dengan kredensial Cloudflare Anda
# Atau export langsung di shell sebelum menjalankan wrangler:
# export CLOUDFLARE_API_TOKEN="token_anda"
# export CLOUDFLARE_ACCOUNT_ID="account_id_anda"

CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

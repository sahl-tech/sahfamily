---
import { curatedResources } from '../data/resources';
import type { Lang } from '../data/siteConfig';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const books = curatedResources.filter((r) => r.type === 'book');
const apps = curatedResources.filter((r) => r.type === 'app');
const gear = curatedResources.filter((r) => r.type === 'gear');
---

<section id="resources" class="py-16 md:py-24 bg-amber-50/50 border-t border-amber-200/60 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-14">
      <div class="inline-block px-3 py-1 rounded-full bg-amber-200 text-amber-900 text-xs font-black uppercase tracking-wider mb-2">
        {lang === 'id' ? 'Alat Bantu Belajar' : 'Learning Toolkit'}
      </div>
      <h2 class="text-3xl md:text-4xl font-black text-slate-900">
        {lang === 'id' ? 'Buku, Aplikasi & Perlengkapan Pilihan' : 'Books, Apps & Field Tools'}
      </h2>
      <p class="mt-3 text-slate-600 max-w-xl mx-auto font-medium">
        {lang === 'id'
          ? 'Hanya alat-alat yang terbukti awet, bebas distrasi algoritma, dan benar-benar kami gunakan dalam keseharian.'
          : 'Strictly battle-tested books and tools free from advertising traps, used daily in our home studio.'}
      </p>
    </div>

    <!-- Category Tabs Layout -->
    <div class="space-y-12">
      <!-- Section: Books -->
      <div>
        <h3 class="text-xl font-black text-slate-900 mb-6 flex items-center gap-2">
          <span>📚</span>
          <span>{lang === 'id' ? 'Buku Panduan & Bacaan Anak' : 'Curated Literature & Parent Guides'}</span>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {books.map((b) => (
            <div class="bg-white p-6 rounded-3xl border-2 border-amber-200 shadow-xs flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-3xl">{b.icon}</span>
                  <span class="px-2.5 py-0.5 rounded-full text-2xs font-extrabold bg-amber-100 text-amber-800">
                    {b.badge[lang]}
                  </span>
                </div>
                <h4 class="font-heading font-black text-slate-900 text-base mb-2">{b.title}</h4>
                <p class="text-xs text-slate-600 leading-relaxed font-medium mb-4">{b.desc[lang]}</p>
              </div>
              <div class="pt-3 border-t border-slate-100 text-2xs font-bold text-slate-400">
                {lang === 'id' ? 'Target: ' : 'Target: '}<strong class="text-slate-600">{b.targetAge}</strong>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Section: Apps -->
      <div>
        <h3 class="text-xl font-black text-slate-900 mb-6 flex items-center gap-2">
          <span>📱</span>
          <span>{lang === 'id' ? 'Aplikasi & Software Kreatif' : 'Creative & Inquiry Apps'}</span>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {apps.map((a) => (
            <div class="bg-white p-6 rounded-3xl border-2 border-teal-200 shadow-xs flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-3xl">{a.icon}</span>
                  <span class="px-2.5 py-0.5 rounded-full text-2xs font-extrabold bg-teal-100 text-teal-800">
                    {a.badge[lang]}
                  </span>
                </div>
                <h4 class="font-heading font-black text-slate-900 text-base mb-2">{a.title}</h4>
                <p class="text-xs text-slate-600 leading-relaxed font-medium mb-4">{a.desc[lang]}</p>
              </div>
              <div class="pt-3 border-t border-slate-100 text-2xs font-bold text-slate-400">
                {lang === 'id' ? 'Target: ' : 'Target: '}<strong class="text-slate-600">{a.targetAge}</strong>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Section: Physical Gear -->
      <div>
        <h3 class="text-xl font-black text-slate-900 mb-6 flex items-center gap-2">
          <span>🎒</span>
          <span>{lang === 'id' ? 'Alat Eksplorasi Fisik & Seni' : 'Tactile Field Gear & Art Kits'}</span>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {gear.map((g) => (
            <div class="bg-white p-6 rounded-3xl border-2 border-purple-200 shadow-xs flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-3xl">{g.icon}</span>
                  <span class="px-2.5 py-0.5 rounded-full text-2xs font-extrabold bg-purple-100 text-purple-800">
                    {g.badge[lang]}
                  </span>
                </div>
                <h4 class="font-heading font-black text-slate-900 text-base mb-2">{g.title}</h4>
                <p class="text-xs text-slate-600 leading-relaxed font-medium mb-4">{g.desc[lang]}</p>
              </div>
              <div class="pt-3 border-t border-slate-100 text-2xs font-bold text-slate-400">
                {lang === 'id' ? 'Target: ' : 'Target: '}<strong class="text-slate-600">{g.targetAge}</strong>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

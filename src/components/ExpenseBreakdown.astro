---
import { expenseAllocation } from '../data/expense';
import type { Lang } from '../data/siteConfig';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="expense" class="py-16 md:py-24 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-14">
      <div class="inline-block px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-black uppercase tracking-wider mb-2">
        {lang === 'id' ? 'Transparansi Tanpa Angka Tabu' : 'Honest Economics'}
      </div>
      <h2 class="text-3xl md:text-4xl font-black text-slate-900">
        {lang === 'id' ? 'Bagaimana Kami Mengalokasikan Anggaran?' : 'How We Allocate Our Family Budget'}
      </h2>
      <p class="mt-3 text-slate-600 max-w-2xl mx-auto font-medium">
        {lang === 'id'
          ? 'Kami percaya transparansi nilai lebih penting daripada pamer nominal. Berikut adalah proporsi pembagian pengeluaran bulanan dan gaya hidup kami.'
          : 'Values matter more than arbitrary figures. Here is our deliberate percentage breakdown supporting slow living, education, and remote work.'}
      </p>
    </div>

    <!-- Visual Breakdown Bar -->
    <div class="bg-white p-6 sm:p-8 rounded-3xl border-2 border-emerald-200/80 shadow-md mb-10 max-w-4xl mx-auto">
      <div class="mb-4 flex items-center justify-between">
        <span class="text-xs font-black uppercase tracking-wider text-slate-500">
          {lang === 'id' ? 'Distribusi Proporsi 100%' : '100% Proportion Distribution'}
        </span>
        <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
          🌱 Zero Debt Lifestyle
        </span>
      </div>

      <!-- Segmented Bar -->
      <div class="w-full h-8 sm:h-10 rounded-2xl overflow-hidden flex shadow-inner border border-black/10">
        {expenseAllocation.map((item) => (
          <div
            style={`width: ${item.percentage}%; background-color: ${item.color};`}
            class="h-full flex items-center justify-center text-white text-xs font-black transition-all hover:opacity-90 relative group"
            title={`${item.category[lang]}: ${item.percentage}%`}
          >
            <span class="truncate px-1 hidden sm:inline">{item.icon} {item.percentage}%</span>
          </div>
        ))}
      </div>

      <!-- Legend -->
      <div class="mt-6 flex flex-wrap gap-4 items-center justify-center text-xs font-bold text-slate-700">
        {expenseAllocation.map((item) => (
          <div class="flex items-center gap-1.5">
            <span class="w-3.5 h-3.5 rounded-md" style={`background-color: ${item.color}`}></span>
            <span>{item.category[lang]} ({item.percentage}%)</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Cards detailing each allocation category -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {expenseAllocation.map((cat) => (
        <div class="bg-white rounded-3xl p-6 border-2 border-slate-200 shadow-xs hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl p-2.5 bg-slate-50 rounded-2xl border border-slate-100">{cat.icon}</span>
              <div class="text-right">
                <span class="text-2xl font-black text-slate-900">{cat.percentage}%</span>
                <span class="block text-2xs uppercase font-extrabold text-slate-400">Alokasi</span>
              </div>
            </div>

            <h3 class="text-lg font-black text-slate-900 mb-2">
              {cat.category[lang]}
            </h3>

            <p class="text-xs text-slate-600 leading-relaxed font-medium mb-4">
              {cat.description[lang]}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-100 bg-slate-50/80 -mx-6 -mb-6 p-4 rounded-b-3xl">
            <span class="block text-2xs font-extrabold uppercase text-slate-400 mb-1">
              {lang === 'id' ? 'Fokus Nilai:' : 'Value Focus:'}
            </span>
            <p class="text-xs font-bold text-slate-700">
              {cat.allocationFocus[lang]}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

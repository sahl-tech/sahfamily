---
import { siteConfig, type Lang } from '../data/siteConfig';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const navItems = siteConfig.nav[lang];
const targetLangUrl = lang === 'id' ? '/en/' : '/';
const switchLangText = lang === 'id' ? 'English 🇺🇸' : 'Indonesia 🇮🇩';
---

<header class="sticky top-4 z-50 px-4 max-w-6xl mx-auto w-full transition-all duration-300">
  <nav class="bg-white/85 backdrop-blur-md border-2 border-amber-200/80 shadow-md shadow-amber-900/5 rounded-3xl px-4 py-3 flex items-center justify-between gap-4">
    <a href={lang === 'id' ? '/' : '/en/'} class="flex items-center gap-2 group">
      <span class="text-2xl group-hover:scale-110 transition-transform">🏡</span>
      <span class="font-heading font-black text-xl tracking-tight text-amber-950">
        sah<span class="text-rose-500">family</span><span class="text-xs ml-0.5 text-teal-600 font-bold">.my.id</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden lg:flex items-center gap-1 xl:gap-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-3 py-1.5 text-sm font-bold text-slate-700 hover:text-rose-600 hover:bg-rose-50 rounded-full transition-colors"
        >
          {item.label}
        </a>
      ))}
    </div>

    <!-- Right Action & Language Switcher -->
    <div class="flex items-center gap-2">
      <a
        href={targetLangUrl}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-amber-100 hover:bg-amber-200 text-amber-900 border border-amber-300/80 transition-all hover:scale-105 active:scale-95 shadow-xs"
        title="Ganti Bahasa / Switch Language"
      >
        <span>🌐</span>
        <span>{switchLangText}</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobileMenuBtn"
        type="button"
        aria-label="Toggle menu"
        class="lg:hidden p-2 rounded-2xl bg-amber-50 text-slate-700 hover:bg-amber-100 border border-amber-200"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobileDropdown"
    class="hidden lg:hidden mt-2 bg-white/95 backdrop-blur-md border-2 border-amber-200 rounded-2xl p-4 shadow-xl flex-col gap-2"
  >
    {navItems.map((item) => (
      <a
        href={item.href}
        class="mobile-nav-link block px-4 py-2 text-sm font-bold text-slate-800 hover:bg-amber-50 hover:text-amber-900 rounded-xl"
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileDropdown');
  const links = document.querySelectorAll('.mobile-nav-link');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      menu.classList.toggle('flex');
    });

    links.forEach(l => {
      l.addEventListener('click', () => {
        menu.classList.add('hidden');
        menu.classList.remove('flex');
      });
    });
  }
</script>

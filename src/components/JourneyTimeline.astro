---
import { journeyMilestones } from '../data/journey';
import type { Lang } from '../data/siteConfig';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="journey" class="py-16 md:py-24 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-16">
      <div class="inline-block px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-black uppercase tracking-wider mb-2">
        {lang === 'id' ? 'Lini Masa Keluarga' : 'Milestone Chronicles'}
      </div>
      <h2 class="text-3xl md:text-4xl font-black text-slate-900">
        {lang === 'id' ? 'Journey: Dari Nol Sampai Sekarang' : 'Our Journey: From Step One to Today'}
      </h2>
      <p class="mt-3 text-slate-600 max-w-xl mx-auto font-medium">
        {lang === 'id'
          ? 'Bukan perjalanan instan, melainkan ribuan eksperimen kecil, kompromi, dan keberanian mencoba jalan yang tidak umum.'
          : 'Not an overnight leap, but compounding series of experiments, pivots, and courage to venture off the beaten path.'}
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="relative border-l-4 border-amber-300 ml-4 md:ml-32 pl-6 md:pl-10 space-y-12">
      {journeyMilestones.map((item) => (
        <div class="relative group">
          <!-- Timeline Node Icon -->
          <div class="absolute -left-[35px] md:-left-[51px] top-0.5 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white border-4 border-amber-400 flex items-center justify-center text-lg md:text-xl shadow-md group-hover:scale-110 transition-transform">
            {item.icon}
          </div>

          <!-- Date Badge for Mobile & Desktop -->
          <div class="md:absolute md:-left-44 md:top-2 md:w-28 md:text-right mb-2 md:mb-0">
            <span class="inline-block px-3 py-1 bg-amber-200/80 text-amber-950 font-black text-xs rounded-full">
              {item.year}
            </span>
          </div>

          <!-- Milestone Content Card -->
          <div class="bg-white p-6 sm:p-7 rounded-3xl border-2 border-amber-200/90 shadow-sm hover:shadow-md transition-shadow">
            <div class="inline-block px-2.5 py-0.5 bg-rose-100 text-rose-800 text-2xs font-extrabold uppercase rounded-full mb-2">
              {item.badge[lang]}
            </div>
            
            <h3 class="text-xl font-black text-slate-900 mb-2">
              {item.title[lang]}
            </h3>
            
            <p class="text-sm text-slate-700 leading-relaxed font-medium mb-4">
              {item.desc[lang]}
            </p>

            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-teal-50 border border-teal-200 text-teal-800 text-xs font-bold">
              <span>📌</span>
              <span>{item.highlight[lang]}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
import { strugglesData } from '../data/struggles';
import type { Lang } from '../data/siteConfig';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="struggles" class="py-16 md:py-24 bg-rose-50/50 border-y border-rose-200/60 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-14">
      <div class="inline-block px-3 py-1 rounded-full bg-rose-200 text-rose-900 text-xs font-black uppercase tracking-wider mb-2">
        {lang === 'id' ? 'Sisi Jujur & Realita' : 'Radical Honesty'}
      </div>
      <h2 class="text-3xl md:text-4xl font-black text-slate-900">
        {lang === 'id' ? 'Tantangan, Frustrasi & Pelajaran Berharga' : 'The Real Struggles & Hard-Won Lessons'}
      </h2>
      <p class="mt-3 text-slate-600 max-w-2xl mx-auto font-medium">
        {lang === 'id'
          ? 'Homeschooling & slow travel tidak seindah feed media sosial. Ada hari-hari kacau, lelah, dan penuh keraguan. Inilah cara kami melaluinya.'
          : 'Homeschooling & slow travel are far from picture-perfect feeds. There are messy meltdowns, doubts, and exhaustion. Here is how we navigate them.'}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {strugglesData.map((item) => (
        <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-rose-200/80 shadow-xs hover:shadow-md transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <span class="text-3xl p-2 bg-rose-100 rounded-2xl">{item.icon}</span>
              <h3 class="text-lg sm:text-xl font-black text-slate-900">
                {item.topic[lang]}
              </h3>
            </div>

            <!-- The Struggle -->
            <div class="mb-4 bg-rose-50/70 p-4 rounded-2xl border border-rose-100">
              <span class="block text-2xs font-extrabold uppercase text-rose-700 tracking-wider mb-1">
                ⚠️ {lang === 'id' ? 'Tantangannya:' : 'The Friction:'}
              </span>
              <p class="text-xs sm:text-sm text-slate-700 font-medium leading-relaxed">
                {item.theStruggle[lang]}
              </p>
            </div>

            <!-- The Reality Check & Lesson -->
            <div class="mb-4 bg-teal-50/70 p-4 rounded-2xl border border-teal-100">
              <span class="block text-2xs font-extrabold uppercase text-teal-800 tracking-wider mb-1">
                💡 {lang === 'id' ? 'Pelajaran yang Dipetik:' : 'The Mindset Shift:'}
              </span>
              <p class="text-xs sm:text-sm text-slate-800 font-bold leading-relaxed">
                {item.lessonLearned[lang]}
              </p>
            </div>
          </div>

          <!-- Practical Tip -->
          <div class="pt-4 border-t border-slate-100 flex items-start gap-2 text-xs font-semibold text-slate-600">
            <span class="text-base leading-none">🎯</span>
            <div>
              <strong class="text-slate-800">{lang === 'id' ? 'Tips Konkret: ' : 'Practical Tip: '}</strong>
              <span>{item.practicalTip[lang]}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

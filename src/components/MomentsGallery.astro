---
import { momentsData } from '../data/moments';
import type { Lang } from '../data/siteConfig';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="momen" class="py-16 md:py-24 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-14">
      <div class="inline-block px-3 py-1 rounded-full bg-purple-100 text-purple-900 text-xs font-black uppercase tracking-wider mb-2">
        {lang === 'id' ? 'Galeri Cerita & Polaroid' : 'Visual Vignettes'}
      </div>
      <h2 class="text-3xl md:text-4xl font-black text-slate-900">
        {lang === 'id' ? 'Momen-Momen yang Membekas' : 'Moments Etched in Memory'}
      </h2>
      <p class="mt-3 text-slate-600 max-w-xl mx-auto font-medium">
        {lang === 'id'
          ? 'Potongan ingatan hangat. Untuk menjaga privasi anak, momen diabadikan dalam bentuk scrapbook cerita & ilustrasi doodle.'
          : 'Glimpses of everyday wonder. Designed in privacy-friendly scrapbook vignettes and creative doodles.'}
      </p>
    </div>

    <!-- Polaroid-like Scrapbook Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {momentsData.map((moment, idx) => (
        <div class="relative bg-white p-5 rounded-2xl border-2 border-slate-200 shadow-md hover:shadow-xl transition-all transform hover:-translate-y-1 hover:rotate-1 flex flex-col justify-between">
          
          <!-- Masking Tape Visual Accent -->
          <div class={`absolute -top-3 left-1/2 -translate-x-1/2 w-20 h-6 ${moment.tapeColor} opacity-80 rotate-2 shadow-2xs rounded-xs`}></div>

          <div>
            <!-- Illustration / Doodle Area (Privacy-friendly) -->
            <div class="w-full aspect-4/3 rounded-xl bg-amber-50/70 border border-dashed border-amber-300 flex flex-col items-center justify-center p-4 mb-4 text-center">
              {moment.doodleSvg === 'crab' && <span class="text-5xl">🦀🌊</span>}
              {moment.doodleSvg === 'rocket' && <span class="text-5xl">🚀💻</span>}
              {moment.doodleSvg === 'train' && <span class="text-5xl">🚂🌾</span>}
              {moment.doodleSvg === 'pottery' && <span class="text-5xl">🏺🎨</span>}
              <span class="mt-2 text-2xs font-extrabold uppercase text-amber-800 tracking-wider">
                {moment.category[lang]}
              </span>
            </div>

            <div class="flex items-center justify-between text-2xs font-bold text-slate-400 mb-1">
              <span>{moment.date}</span>
              <span>📍 {moment.location}</span>
            </div>

            <h3 class="font-heading font-black text-lg text-slate-900 mb-2 leading-tight">
              {moment.title[lang]}
            </h3>

            <p class="text-xs text-slate-600 leading-relaxed font-medium">
              "{moment.caption[lang]}"
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-2xs text-slate-400 font-bold">
            <span>#sahfamily</span>
            <span>Memori #{idx + 1}</span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

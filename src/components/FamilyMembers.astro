---
import { familyMembers } from '../data/family';
import type { Lang } from '../data/siteConfig';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="tentang" class="py-16 md:py-20 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <div class="inline-block px-3 py-1 rounded-full bg-teal-100 text-teal-800 text-xs font-black uppercase tracking-wider mb-2">
        {lang === 'id' ? 'Keluarga Kecil Kami' : 'The Crew'}
      </div>
      <h2 class="text-3xl md:text-4xl font-black text-slate-900">
        {lang === 'id' ? 'Siapa Saja yang Berpetualang?' : 'Meet the Sahfamily Explorers'}
      </h2>
      <p class="mt-3 text-slate-600 max-w-xl mx-auto font-medium">
        {lang === 'id' 
          ? 'Empat orang dengan rasa penasaran tinggi, peran yang saling mengisi, dan komitmen untuk belajar sepanjang hayat.' 
          : 'Four curious minds complementing each other with a lifelong learning mindset.'}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {familyMembers.map((member) => (
        <div class={`p-6 sm:p-8 rounded-3xl border-2 shadow-sm ${member.accentColor} custom-card flex flex-col justify-between`}>
          <div>
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="flex items-center gap-3">
                <div class="w-16 h-16 rounded-2xl bg-white shadow-xs flex items-center justify-center text-4xl border border-black/10">
                  {member.emoji}
                </div>
                <div>
                  <h3 class="text-2xl font-black text-slate-900">{member.nickname}</h3>
                  <p class="text-xs font-bold uppercase tracking-wider text-slate-600">{member.role[lang]}</p>
                </div>
              </div>
            </div>

            <div class="mb-4">
              <p class="text-sm font-bold text-slate-800 italic bg-white/70 px-3 py-2 rounded-xl border border-black/5">
                "{member.tagline[lang]}"
              </p>
            </div>

            <p class="text-sm text-slate-700 leading-relaxed font-medium mb-6">
              {member.bio[lang]}
            </p>
          </div>

          <div class="pt-4 border-t border-black/10 flex flex-wrap gap-2 items-center">
            <span class="text-xs font-extrabold uppercase text-slate-500">
              {lang === 'id' ? 'Fokus:' : 'Focus:'}
            </span>
            {member.interests.map((interest) => (
              <span class="px-2.5 py-1 text-xs font-bold rounded-lg bg-white/90 text-slate-700 shadow-2xs border border-black/5">
                {interest}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

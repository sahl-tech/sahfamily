---
import { learningSubjects } from '../data/learning';
import type { Lang } from '../data/siteConfig';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="belajar" class="py-16 md:py-24 bg-white/60 border-y border-amber-200/60 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="text-center mb-12">
      <div class="inline-block px-3 py-1 rounded-full bg-rose-100 text-rose-800 text-xs font-black uppercase tracking-wider mb-2">
        {lang === 'id' ? 'Kurikulum Nyata & Relevan' : 'Living Curriculum'}
      </div>
      <h2 class="text-3xl md:text-4xl font-black text-slate-900">
        {lang === 'id' ? 'Apa yang Dipelajari Anak-Anak?' : 'What Do the Kids Actually Learn?'}
      </h2>
      <p class="mt-3 text-slate-600 max-w-2xl mx-auto font-medium">
        {lang === 'id'
          ? 'Kami memadukan inquiry-based homeschool, computational logic, dan petualangan worldschooling ke dalam 6 pilar hidup nyata.'
          : 'Blending inquiry-led homeschool, computational mastery, and worldschooling journeys into 6 real-world core pillars.'}
      </p>
    </div>

    <!-- Grid of 6 learning pillars -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {learningSubjects.map((sub) => (
        <div class={`p-6 rounded-3xl border-2 shadow-xs ${sub.bgColor} custom-card flex flex-col justify-between`}>
          <div>
            <!-- Header Card -->
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl p-2.5 bg-white rounded-2xl shadow-xs border border-black/5">{sub.icon}</span>
              <div class="flex items-center gap-2">
                <span class="text-2xs font-extrabold uppercase px-2.5 py-1 bg-white/80 rounded-full border border-black/5">
                  {sub.ageRange}
                </span>
                <span class="text-2xs font-extrabold uppercase px-2.5 py-1 bg-white/80 rounded-full border border-black/5">
                  {sub.category[lang]}
                </span>
              </div>
            </div>

            <h3 class="text-xl font-black text-slate-900 mb-2 leading-snug">
              {sub.title[lang]}
            </h3>

            <p class="text-xs sm:text-sm text-slate-700 font-medium mb-4 leading-relaxed">
              {sub.summary[lang]}
            </p>

            <!-- Learning Outcomes -->
            <div class="mb-4 bg-white/70 p-3.5 rounded-2xl border border-black/5">
              <div class="text-xs font-black text-slate-800 mb-2 uppercase tracking-wide">
                {lang === 'id' ? '🎯 Target Kompetensi:' : '🎯 Core Competencies:'}
              </div>
              <ul class="space-y-1 text-xs text-slate-700 font-medium">
                {sub.outcomes[lang].map((outcome) => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-emerald-600 font-bold">✓</span>
                    <span>{outcome}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Hands-on Project Activity -->
          <div class="pt-3 border-t border-black/10">
            <span class="block text-2xs font-black uppercase text-slate-500 mb-1">
              {lang === 'id' ? '🛠️ Proyek / Praktek Nyata:' : '🛠️ Real-World Project:'}
            </span>
            <p class="text-xs font-bold text-slate-800 italic">
              "{sub.handsOnActivity[lang]}"
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom takeaway quote -->
    <div class="mt-12 bg-amber-100/70 border-2 border-amber-300 rounded-2xl p-6 text-center max-w-3xl mx-auto shadow-xs">
      <p class="text-sm md:text-base font-bold text-amber-950">
        💡 {lang === 'id'
          ? 'Prinsip kami: "Bukan berapa banyak rumus yang dihafal, melainkan seberapa jernih anak berpikir, bertanya, dan mencari jawaban sendiri."'
          : 'Our core ethos: "It\'s never about how many formulas are crammed, but how clearly the child observes, questions, and navigates solutions independently."'}
      </p>
    </div>

  </div>
</section>
